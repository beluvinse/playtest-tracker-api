@host = http://localhost:5185

# Everything belongs to an organization, and you only see the ones you are a member of.
# Signing up creates your personal organization. "List my organizations" (below) shows the
# ids of the ones you are in: use one as @organizationId.
# @otherOrganizationId is an organization you are NOT a member of (any other person's).
# @memberUserId is the "userId" of a person from "List the members" (below).
@organizationId = 1
@otherOrganizationId = 2
@memberUserId = paste-a-user-id-here

# Ids that exist in the sample data. Change them if your database is different.
# Create a project and a bug first (below) and use their ids here.
# @projectId has bugs, @bugId belongs to it.
@projectId = 4
@bugId = 5
@otherProjectId = 5
@missingId = 999

# Every request below (except Register, Login and the demo info) sends this token. Run "Login" first, copy the
# "token" from the response and paste it here. It expires after Jwt:ExpiresMinutes (60 by default):
# when requests start answering 401, log in again and paste the new one.
@token = paste-the-token-here


### ===================== DEMO =====================

### The demo accounts and their shared password → 200 (public: no token needed; 404 if there is no demo)
GET {{host}}/api/demo

### Sign in as the demo's Owner → 200 with the token (copy it into @token at the top)
# The password is the one "GET /api/demo" shows (Demo:Password in appsettings.json).
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "luna@demo.test",
  "password": "Playtest-demo-1"
}

### Sign in as a demo Member → 200 (can edit bugs and projects, but not the organization's structure)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "theo@demo.test",
  "password": "Playtest-demo-1"
}


### ===================== AUTHENTICATION =====================

### Register → 201 (also signs you in: the response has the token)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "ana@example.com",
  "password": "Sunflower7",
  "displayName": "Ana"
}

### Register with a password that is too weak → 400 (8+ characters, a digit and a lowercase letter)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "ana2@example.com",
  "password": "short",
  "displayName": "Ana"
}

### Register with an email that already has an account → 409
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "ana@example.com",
  "password": "Sunflower7",
  "displayName": "Ana"
}

### Login → 200 with the token (copy it into @token at the top)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "ana@example.com",
  "password": "Sunflower7"
}

### Login with a wrong password → 401 (5 in a row lock the account for 10 minutes → 423)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "ana@example.com",
  "password": "Wrongpass1"
}

### Who am I → 200 with your user (401 if the token is missing, wrong or expired)
GET {{host}}/api/auth/me
Authorization: Bearer {{token}}

### Projects without a token → 401 (no Authorization header on purpose)
GET {{host}}/api/organizations/{{organizationId}}/projects


### ===================== ORGANIZATIONS =====================

### List my organizations → 200 (the personal one first, with my role, member count and project count)
GET {{host}}/api/organizations
Authorization: Bearer {{token}}

### Get one organization → 200 (404 if you are not a member, same as if it didn't exist)
GET {{host}}/api/organizations/{{organizationId}}
Authorization: Bearer {{token}}

### Get an organization you are NOT a member of → 404
GET {{host}}/api/organizations/{{otherOrganizationId}}
Authorization: Bearer {{token}}

### Create an organization → 201 (you become its only Owner)
POST {{host}}/api/organizations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Night Owls Studio"
}

### Create an organization with a name that is too short → 400
POST {{host}}/api/organizations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "A"
}

### Rename an organization → 200 (only the Owner; a Member gets 403)
PUT {{host}}/api/organizations/{{organizationId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Night Owls Games"
}

### Delete an organization → 204 (only the Owner, never the demo one, and 409 while it has projects)
# Use an organization created just for this, not your personal one.
DELETE {{host}}/api/organizations/{{organizationId}}
Authorization: Bearer {{token}}


### ===================== ORGANIZATION MEMBERS =====================

### List the members → 200 (any member; the Owner comes first; paged, up to 50 per page)
GET {{host}}/api/organizations/{{organizationId}}/members?page=1&pageSize=10
Authorization: Bearer {{token}}

### Add someone by email → 201 (only the Owner; the person must already have an account)
POST {{host}}/api/organizations/{{organizationId}}/members
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "ben@example.com"
}

### Add an email nobody has signed up with → 404 (the message is on the "Email" field)
POST {{host}}/api/organizations/{{organizationId}}/members
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "nobody@example.com"
}

### Add someone who is already in → 409
POST {{host}}/api/organizations/{{organizationId}}/members
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "ben@example.com"
}

### Remove a member → 204 (the Owner removes anybody; a Member can only remove themselves, to leave)
DELETE {{host}}/api/organizations/{{organizationId}}/members/{{memberUserId}}
Authorization: Bearer {{token}}

### Remove the Owner → 409 (an organization always keeps its owner)
# Paste the Owner's userId in @memberUserId first.
DELETE {{host}}/api/organizations/{{organizationId}}/members/{{memberUserId}}
Authorization: Bearer {{token}}


### ===================== PROJECTS =====================

### List projects (newest first, each with its bugCount and openCriticalCount)
GET {{host}}/api/organizations/{{organizationId}}/projects
Authorization: Bearer {{token}}

### List the projects of an organization you are NOT a member of → 404 (same as if it didn't exist)
GET {{host}}/api/organizations/{{otherOrganizationId}}/projects
Authorization: Bearer {{token}}

### Create a project in an organization you are NOT a member of → 404
POST {{host}}/api/organizations/{{otherOrganizationId}}/projects
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Sneaky",
  "code": "SNK"
}

### Get one project (404 too if it belongs to an organization you are not in)
GET {{host}}/api/projects/{{projectId}}
Authorization: Bearer {{token}}

### Get a project that does not exist → 404
GET {{host}}/api/projects/{{missingId}}
Authorization: Bearer {{token}}

### Create project → 201 (the code is stored in uppercase: "png" → "PNG")
POST {{host}}/api/organizations/{{organizationId}}/projects
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Ping Pong",
  "code": "png",
  "description": "Table tennis prototype"
}

### Create project with a name that is too short → 400
POST {{host}}/api/organizations/{{organizationId}}/projects
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "A",
  "code": "AAA"
}

### Create project with an invalid code → 400 (exactly 3 letters, no digits)
POST {{host}}/api/organizations/{{organizationId}}/projects
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Ping Pong",
  "code": "PP2"
}

### Create project with a code another project of the SAME organization uses → 409
# (codes are unique inside an organization: another organization can have its own PIN)
POST {{host}}/api/organizations/{{organizationId}}/projects
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Pinball",
  "code": "PIN"
}

### Update project → 200 (it can keep its own code, or change to a free one)
PUT {{host}}/api/projects/{{projectId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Pink in the Night",
  "code": "PIN",
  "description": "Seated VR experience"
}

### Update project with another project's code → 409
PUT {{host}}/api/projects/{{projectId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Pink in the Night",
  "code": "DUN",
  "description": "Seated VR experience"
}

### Delete a project that still has bugs → 409
DELETE {{host}}/api/projects/{{projectId}}
Authorization: Bearer {{token}}

### Delete a project that does not exist → 404
DELETE {{host}}/api/projects/{{missingId}}
Authorization: Bearer {{token}}

### Delete a project without bugs → 204
# Use the id returned by "Create project" above.
DELETE {{host}}/api/projects/0
Authorization: Bearer {{token}}


### ===================== BUGS INSIDE A PROJECT =====================
# Listing and creating bugs happen inside a project: the project comes from the URL.

### List the bugs of a project (newest first, 10 per page)
GET {{host}}/api/projects/{{projectId}}/bugs
Authorization: Bearer {{token}}

### Open bugs of a project, most severe first
GET {{host}}/api/projects/{{projectId}}/bugs?status=Open&sortBy=severity&descending=true
Authorization: Bearer {{token}}

### Pagination: second page of 2
GET {{host}}/api/projects/{{projectId}}/bugs?page=2&pageSize=2
Authorization: Bearer {{token}}

### Bugs of a project that does not exist → 404
GET {{host}}/api/projects/{{missingId}}/bugs
Authorization: Bearer {{token}}

### Create bug in a project → 201 (always starts as Open)
POST {{host}}/api/projects/{{projectId}}/bugs
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Player doesn't respawn",
  "description": "Player does not respawn after dying.",
  "severity": "High"
}

### Create bug with invalid fields → 400 (title too short, unknown severity)
POST {{host}}/api/projects/{{projectId}}/bugs
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "",
  "description": "Player does not respawn after dying.",
  "severity": 5
}

### Create bug in a project that does not exist → 404
POST {{host}}/api/projects/{{missingId}}/bugs
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Player doesn't respawn",
  "description": "Player does not respawn after dying.",
  "severity": "High"
}

### Delete every bug of a project → 204 (the project stays, now with bugCount 0)
# Careful: this really deletes them, and there is no undo.
# Use a project created for testing (the id returned by "Create project" above).
# Afterwards "Delete a project without bugs" works on it.
DELETE {{host}}/api/projects/0/bugs
Authorization: Bearer {{token}}

### Delete every bug of a project that does not exist → 404
DELETE {{host}}/api/projects/{{missingId}}/bugs
Authorization: Bearer {{token}}


### ===================== SINGLE BUG =====================
# Once a bug exists, it is reached by its own id.

### Get one bug
GET {{host}}/api/bugs/{{bugId}}
Authorization: Bearer {{token}}

### Get a bug that does not exist → 404
GET {{host}}/api/bugs/{{missingId}}
Authorization: Bearer {{token}}


### ===================== SEARCH ACROSS PROJECTS =====================

### Every bug, from every project
GET {{host}}/api/bugs
Authorization: Bearer {{token}}

### Critical bugs in any project
GET {{host}}/api/bugs?severity=Critical
Authorization: Bearer {{token}}

### Search in title and description
GET {{host}}/api/bugs?search=map
Authorization: Bearer {{token}}

### Filter by project → an empty list (not 404) when the project does not exist
GET {{host}}/api/bugs?projectId={{missingId}}
Authorization: Bearer {{token}}


### ===================== BUGS: PATCH =====================
# PATCH changes only the fields you send. Fields left out (or sent as null) stay as they are.
# These requests modify @bugId for real.

### Change only the status → 200
PATCH {{host}}/api/bugs/{{bugId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "Resolved"
}

### Change title and severity → 200
PATCH {{host}}/api/bugs/{{bugId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Hands clip through table",
  "severity": "High"
}

### Move bug to another project → 200
PATCH {{host}}/api/bugs/{{bugId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "projectId": {{otherProjectId}}
}

### Move bug back → 200
PATCH {{host}}/api/bugs/{{bugId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "projectId": {{projectId}}
}

### Empty body → 400 (at least one field must be provided)
PATCH {{host}}/api/bugs/{{bugId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
}

### Misspelled field → 400 (unknown fields are ignored, so the body counts as empty)
PATCH {{host}}/api/bugs/{{bugId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "stauts": "Closed"
}

### Move to a project that does not exist → 400
PATCH {{host}}/api/bugs/{{bugId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "projectId": {{missingId}}
}

### Patch a bug that does not exist → 404
PATCH {{host}}/api/bugs/{{missingId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "Open"
}


### ===================== BUGS: UPDATE AND DELETE =====================

### Update bug → 200
# PUT replaces the whole bug: send every field, not only the one you change.
# To change just one or two fields, use PATCH instead.
PUT {{host}}/api/bugs/{{bugId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "projectId": {{projectId}},
  "title": "Hands clip through table",
  "description": "Controller hands go through the table mesh when leaning forward.",
  "severity": "Medium",
  "status": "InProgress"
}

### Move bug to another project → 200
PUT {{host}}/api/bugs/{{bugId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "projectId": {{otherProjectId}},
  "title": "Hands clip through table",
  "description": "Controller hands go through the table mesh when leaning forward.",
  "severity": "Medium",
  "status": "InProgress"
}

### Update a bug that does not exist → 404
PUT {{host}}/api/bugs/{{missingId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "projectId": {{projectId}},
  "title": "Does not matter",
  "description": "This bug does not exist.",
  "severity": "Low",
  "status": "Open"
}

### Delete bug → 204
# Use the id returned by "Create bug" above.
DELETE {{host}}/api/bugs/0
Authorization: Bearer {{token}}


### ===================== QUERY VALIDATION =====================

### Page below 1 → 400
GET {{host}}/api/bugs?page=0
Authorization: Bearer {{token}}

### Page size above 50 → 400
GET {{host}}/api/bugs?pageSize=1000
Authorization: Bearer {{token}}

### Unknown sort field → 400
GET {{host}}/api/bugs?sortBy=severty
Authorization: Bearer {{token}}

### Status out of range → 400
GET {{host}}/api/bugs?status=7
Authorization: Bearer {{token}}

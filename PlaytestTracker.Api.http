@host = http://localhost:5185

# Ids that exist in the sample data. Change them if your database is different.
# @projectId has bugs, @bugId belongs to it.
@projectId = 4
@bugId = 5
@otherProjectId = 5
@missingId = 999


### ===================== PROJECTS =====================

### List projects (newest first, each with its bugCount)
GET {{host}}/api/projects

### Get one project
GET {{host}}/api/projects/{{projectId}}

### Get a project that does not exist → 404
GET {{host}}/api/projects/{{missingId}}

### Create project → 201
POST {{host}}/api/projects
Content-Type: application/json

{
  "name": "Pink in the Night",
  "description": "Seated VR experience"
}

### Create project with a name that is too short → 400
POST {{host}}/api/projects
Content-Type: application/json

{
  "name": "A"
}

### Update project → 200
PUT {{host}}/api/projects/{{projectId}}
Content-Type: application/json

{
  "name": "Pink in the Night",
  "description": "Seated VR experience"
}

### Delete a project that still has bugs → 409
DELETE {{host}}/api/projects/{{projectId}}

### Delete a project that does not exist → 404
DELETE {{host}}/api/projects/{{missingId}}

### Delete a project without bugs → 204
# Use the id returned by "Create project" above.
DELETE {{host}}/api/projects/0


### ===================== BUGS INSIDE A PROJECT =====================
# Listing and creating bugs happen inside a project: the project comes from the URL.

### List the bugs of a project (newest first, 10 per page)
GET {{host}}/api/projects/{{projectId}}/bugs

### Open bugs of a project, most severe first
GET {{host}}/api/projects/{{projectId}}/bugs?status=Open&sortBy=severity&descending=true

### Pagination: second page of 2
GET {{host}}/api/projects/{{projectId}}/bugs?page=2&pageSize=2

### Bugs of a project that does not exist → 404
GET {{host}}/api/projects/{{missingId}}/bugs

### Create bug in a project → 201 (always starts as Open)
POST {{host}}/api/projects/{{projectId}}/bugs
Content-Type: application/json

{
  "title": "Player doesn't respawn",
  "description": "Player does not respawn after dying.",
  "severity": "High"
}

### Create bug with invalid fields → 400 (title too short, unknown severity)
POST {{host}}/api/projects/{{projectId}}/bugs
Content-Type: application/json

{
  "title": "",
  "description": "Player does not respawn after dying.",
  "severity": 5
}

### Create bug in a project that does not exist → 404
POST {{host}}/api/projects/{{missingId}}/bugs
Content-Type: application/json

{
  "title": "Player doesn't respawn",
  "description": "Player does not respawn after dying.",
  "severity": "High"
}

### Delete every bug of a project → 204 (the project stays, now with bugCount 0)
# Careful: this really deletes them, and there is no undo.
# Use a project created for testing (the id returned by "Create project" above).
# Afterwards "Delete a project without bugs" works on it.
DELETE {{host}}/api/projects/0/bugs

### Delete every bug of a project that does not exist → 404
DELETE {{host}}/api/projects/{{missingId}}/bugs


### ===================== SINGLE BUG =====================
# Once a bug exists, it is reached by its own id.

### Get one bug
GET {{host}}/api/bugs/{{bugId}}

### Get a bug that does not exist → 404
GET {{host}}/api/bugs/{{missingId}}


### ===================== SEARCH ACROSS PROJECTS =====================

### Every bug, from every project
GET {{host}}/api/bugs

### Critical bugs in any project
GET {{host}}/api/bugs?severity=Critical

### Search in title and description
GET {{host}}/api/bugs?search=map

### Filter by project → an empty list (not 404) when the project does not exist
GET {{host}}/api/bugs?projectId={{missingId}}


### ===================== BUGS: PATCH =====================
# PATCH changes only the fields you send. Fields left out (or sent as null) stay as they are.
# These requests modify @bugId for real.

### Change only the status → 200
PATCH {{host}}/api/bugs/{{bugId}}
Content-Type: application/json

{
  "status": "Resolved"
}

### Change title and severity → 200
PATCH {{host}}/api/bugs/{{bugId}}
Content-Type: application/json

{
  "title": "Hands clip through table",
  "severity": "High"
}

### Move bug to another project → 200
PATCH {{host}}/api/bugs/{{bugId}}
Content-Type: application/json

{
  "projectId": {{otherProjectId}}
}

### Move bug back → 200
PATCH {{host}}/api/bugs/{{bugId}}
Content-Type: application/json

{
  "projectId": {{projectId}}
}

### Empty body → 400 (at least one field must be provided)
PATCH {{host}}/api/bugs/{{bugId}}
Content-Type: application/json

{
}

### Misspelled field → 400 (unknown fields are ignored, so the body counts as empty)
PATCH {{host}}/api/bugs/{{bugId}}
Content-Type: application/json

{
  "stauts": "Closed"
}

### Move to a project that does not exist → 400
PATCH {{host}}/api/bugs/{{bugId}}
Content-Type: application/json

{
  "projectId": {{missingId}}
}

### Patch a bug that does not exist → 404
PATCH {{host}}/api/bugs/{{missingId}}
Content-Type: application/json

{
  "status": "Open"
}


### ===================== BUGS: UPDATE AND DELETE =====================

### Update bug → 200
# PUT replaces the whole bug: send every field, not only the one you change.
# To change just one or two fields, use PATCH instead.
PUT {{host}}/api/bugs/{{bugId}}
Content-Type: application/json

{
  "projectId": {{projectId}},
  "title": "Hands clip through table",
  "description": "Controller hands go through the table mesh when leaning forward.",
  "severity": "Medium",
  "status": "InProgress"
}

### Move bug to another project → 200
PUT {{host}}/api/bugs/{{bugId}}
Content-Type: application/json

{
  "projectId": {{otherProjectId}},
  "title": "Hands clip through table",
  "description": "Controller hands go through the table mesh when leaning forward.",
  "severity": "Medium",
  "status": "InProgress"
}

### Update a bug that does not exist → 404
PUT {{host}}/api/bugs/{{missingId}}
Content-Type: application/json

{
  "projectId": {{projectId}},
  "title": "Does not matter",
  "description": "This bug does not exist.",
  "severity": "Low",
  "status": "Open"
}

### Delete bug → 204
# Use the id returned by "Create bug" above.
DELETE {{host}}/api/bugs/0


### ===================== QUERY VALIDATION =====================

### Page below 1 → 400
GET {{host}}/api/bugs?page=0

### Page size above 50 → 400
GET {{host}}/api/bugs?pageSize=1000

### Unknown sort field → 400
GET {{host}}/api/bugs?sortBy=severty

### Status out of range → 400
GET {{host}}/api/bugs?status=7

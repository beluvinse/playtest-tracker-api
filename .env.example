# Copy this file to ".env" (cp .env.example .env) and fill in the values.
# docker compose reads ".env" by itself. ".env" is ignored by git: real secrets never get committed.

# Password of the database (any text; it only lives on your computer)
DB_PASSWORD=change-me

# Secret that signs the login tokens: 32 or more random characters
# (for example: openssl rand -base64 48)
JWT_KEY=change-me-to-something-long-and-random-at-least-32-chars

# Address of the frontend allowed to call the API (optional, this is the default)
# FRONTEND_URL=http://localhost:5173

# Whether the demo organization exists (optional, default true)
# DEMO_ENABLED=true

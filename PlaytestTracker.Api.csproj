<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a2c9ce6f-69a3-47eb-87cb-dab8edad5996</UserSecretsId>
  </PropertyGroup>

  <!-- The tests live in a folder inside this one. A project compiles every .cs file below it,
       so without this the API would try to compile the test project's files too. -->
  <ItemGroup>
    <Compile Remove="PlaytestTracker.Api.Tests\**" />
    <EmbeddedResource Remove="PlaytestTracker.Api.Tests\**" />
    <None Remove="PlaytestTracker.Api.Tests\**" />
    <!-- A web project also treats every .json file below it as content to copy to its output.
         Without this, the tests' build files (project.assets.json, .deps.json…) got copied in. -->
    <Content Remove="PlaytestTracker.Api.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.*" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.*" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
